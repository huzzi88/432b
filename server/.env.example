# ═══════════════════════════════════════════════════════
# KEPLER432B — Production Environment Configuration
# ═══════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=production         # 'production' enables SSL cookies, strict CSP, HSTS

# Database (use restricted user, NOT postgres!)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kepler432b
DB_USER=kepler432b_app      # restricted role (see sql/security-setup.sql)
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_IN_PRODUCTION
DB_SSL=false                # true only for external DBs (Supabase/Neon/RDS)

# JWT — use 64+ char random secret in production
JWT_SECRET=CHANGE_THIS_USE_openssl_rand_hex_64_TO_GENERATE
JWT_EXPIRES_IN=7d

# Bcrypt — 12 rounds for production (slower = safer)
BCRYPT_ROUNDS=12

# CORS — comma-separated allowed origins
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Admin Credentials (used by seed.ts only)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@kepler432b.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD
ADMIN_PIN=CHANGE_THIS_4_DIGIT_PIN
ADMIN_PIN1=CHANGE_THIS_ADMIN_PIN_1
ADMIN_PIN2=CHANGE_THIS_ADMIN_PIN_2
ADMIN_PIN3=CHANGE_THIS_ADMIN_PIN_3

# ═══════════════════════════════════════════════════════
# CRYPTO DEPOSIT SYSTEM
# ═══════════════════════════════════════════════════════

# Master wallet — all crypto deposits must go TO this address
MASTER_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# Binance Pay (get from Binance Merchant)
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_MERCHANT_ID=

# OKX Pay (get from OKX Merchant)
OKX_PAY_API_KEY=
OKX_PAY_SECRET=
OKX_PAY_PASSPHRASE=

# RPC Endpoints (free public endpoints — upgrade for production)
RPC_BSC=https://bsc-dataseed1.binance.org
RPC_ETH=https://eth.llamarpc.com
RPC_POLYGON=https://polygon-rpc.com
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_BASE=https://mainnet.base.org

# Known stablecoin contracts (defaults are mainnet)
USDT_BSC=0x55d398326f99059fF775485246999027B3197955
USDC_BSC=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
USDT_ETH=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDC_ETH=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDT_POLYGON=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
USDC_POLYGON=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
